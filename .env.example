# 로컬 docker compose 기준값. Supabase 를 쓰면 대시보드의 connection string 으로 바꾼다
DATABASE_URL=postgresql+asyncpg://saetgil:saetgil@localhost:5432/saetgil

# Supabase 프로젝트 URL. JWKS 는 {SUPABASE_URL}/auth/v1/.well-known/jwks.json 에서 받는다
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_JWT_AUDIENCE=authenticated

# 공개 anon 키. 기록 사진을 Storage 에서 내려받을 때 apikey 헤더로 쓴다 (F-11)
SUPABASE_ANON_KEY=
# 기록 사진 비공개 버킷. 프론트가 올리는 버킷과 같아야 한다
SUPABASE_RECORD_BUCKET=records

# 신규 사용자의 기본 도시 (코드에 도시 이름을 쓰지 않는다)
DEFAULT_CITY=daegu

TMAP_APP_KEY=
ODSAY_API_KEY=
# 기상청 단기예보·에어코리아 모두 공공데이터포털 인증키(Decoding)다. 계정당 한 개를 공유한다
KMA_SERVICE_KEY=
AIRKOREA_SERVICE_KEY=
LLM_API_KEY=
LLM_MODEL=claude-opus-5-5

APP_ENV=dev

# --- scripts/seed_demo.py 전용. 앱 런타임(app/)은 이 세 값을 읽지 않는다 ---
# service role key 는 RLS 를 우회하는 관리자 키다. 서버 프로세스에 넣지 않는다
SUPABASE_SERVICE_ROLE_KEY=
DEMO_EMAIL=
DEMO_PASSWORD=
